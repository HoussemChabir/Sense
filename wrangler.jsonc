// A static site: Workers serves dist/ as assets, with no Worker code. With this file, `wrangler deploy` uploads dist/
// instead of trying to add Cloudflare's Vite plugin to vite.config.js.
{
  "name": "sense",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    // Each dist/<path>/index.html is served at /<path>/ (the default html_handling); unknown URLs get 404.html.
    "not_found_handling": "404-page"
  }
}
